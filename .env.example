# Endless Sentinel application
FLASK_SECRET_KEY=
FLASK_HOST=0.0.0.0
FLASK_PORT=8080
LOG_LEVEL=INFO
ENABLE_BACKGROUND_POLLER=true
POLL_INTERVAL_SECONDS=30
DASHBOARD_REFRESH_SECONDS=10
HISTORY_LENGTH=120
SEND_RECOVERY_ALERTS=true

# Proxmox VE: use an API token where possible. Host can be a hostname or URL.
PROXMOX_ENABLED=false
PROXMOX_HOST=
PROXMOX_USER=
PROXMOX_TOKEN_NAME=
PROXMOX_TOKEN_VALUE=
PROXMOX_PASSWORD=
PROXMOX_VERIFY_SSL=true
PROXMOX_TIMEOUT_SECONDS=10
PROXMOX_CPU_WARNING=80
PROXMOX_CPU_CRITICAL=95
PROXMOX_MEMORY_WARNING=80
PROXMOX_MEMORY_CRITICAL=95

# k3s / Kubernetes: choose a mounted kubeconfig or in-cluster authentication.
K3S_ENABLED=false
K3S_KUBECONFIG=/config/kubeconfig
K3S_KUBECONFIG_HOST=/dev/null
K3S_CONTEXT=
K3S_IN_CLUSTER=false
K3S_TIMEOUT_SECONDS=10
K3S_RESTART_WARNING=5

# Docker Engine: setup.sh installs the local engine on supported fresh hosts.
# The collector sees only this daemon unless a secured remote endpoint is configured.
DOCKER_ENABLED=true
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_GID=998
DOCKER_TLS_VERIFY=false
DOCKER_CERT_PATH=/config/docker-certs
DOCKER_CERT_PATH_HOST=/dev/null
DOCKER_TIMEOUT_SECONDS=10
DOCKER_COLLECT_STATS=true
DOCKER_RESTART_WARNING=1
DOCKER_ALLOWED_STOPPED=

# Discord webhook alert delivery
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=Endless Sentinel
DISCORD_TIMEOUT_SECONDS=10

# Docker Compose host binding
ENDLESS_SENTINEL_BIND=0.0.0.0
ENDLESS_SENTINEL_PORT=8080
